# GiraTrip (記啦旅) 環境變數設定範例
# 請複製此檔案為 .env 或 .env.local 並填入您自己的設定值
# 注意：真實金鑰嚴禁提交至 Git 倉庫

# -------------------------------------------------------------
# Google Firebase 設定 (用於動態帳目與即時同步)
# 可至 Firebase Console (https://console.firebase.google.com/) 建立專案並取得 Web App 設定
# 若未設定，系統會自動優雅降級為 Local-First 本機存儲模式
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyPlaceholder_ReplaceWithYours
VITE_FIREBASE_AUTH_DOMAIN=giratrip-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=giratrip-demo
VITE_FIREBASE_STORAGE_BUCKET=giratrip-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -------------------------------------------------------------
# Google Gemini Vision API Key (可選：用於多國外幣收據 OCR 與菜單繁體中文翻譯)
# 可至 Google AI Studio (https://aistudio.google.com/) 免費取得
# 若未填入，系統內建前端離線辨識與智慧模擬解析引擎
# -------------------------------------------------------------
VITE_GEMINI_API_KEY=AIzaSyDummyGeminiKey_ReplaceWithYours

# -------------------------------------------------------------
# Google Sheets 靜態行程同步設定 (可選)
# 支援公開發布為 CSV 的 Google 試算表連結或 Google Apps Script Webhook
# -------------------------------------------------------------
VITE_DEFAULT_GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-dummy/pub?output=csv
